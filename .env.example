APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ============================================================
# Test Signal — External Service Configuration
# ============================================================
TEST_SIGNAL_URL=http://127.0.0.1:9000/api/test/status
TEST_SIGNAL_TIMEOUT=10
LABEL_CAPTURE_DOWNLOAD_TIMEOUT=15

# ============================================================
# OCR Callback — Sinkron dengan FastAPI .env (Fix Retake 401)
# JANGAN commit nilai asli .env ke git — ini hanya template
# ============================================================
OCR_CALLBACK_API_KEY=label-inspection-2026-key
OCR_CALLBACK_SECRET=change-me-64-char-random-for-hmac-sha256-please-rotate
OCR_CALLBACK_URL=http://127.0.0.1:8000/api/ocr/callback
OCR_CALLBACK_TIMEOUT=5
OCR_CALLBACK_RETRY=3
# Alias (backward compat)
LARAVEL_API_KEY=${OCR_CALLBACK_API_KEY}
LARAVEL_HMAC_SECRET=${OCR_CALLBACK_SECRET}
LARAVEL_CALLBACK_URL=${OCR_CALLBACK_URL}

# OCR Preview & Reconcile
OCR_PREVIEW_TIMEOUT=15
OCR_RETAKE_CLEANUP_TIMEOUT=3
# FIX timeout Label 1/2 (2026-10-06): OCR bisa 60-90s/label, batas lama 45s selalu kalah.
# Baru 150s agar polling lanjut sampai FastAPI success. Frontend JS juga dipanjangkan ke 120s (lihat check.js/reference.js).
OCR_POLL_TIMEOUT=150
OCR_POLL_INTERVAL=2
# Optimasi FastAPI R4/R2 (2026-10-06): long-poll ?wait= + resize pre-forward.
OCR_LONGPOLL_WAIT=8
OCR_IMAGE_MAX_SIDE=1600
OCR_ENABLED=true
OCR_RECONCILE_ENABLED=true
OCR_RECONCILE_INTERVAL=5

# ============================================================
# Check Captures — Batch 5 Labels (CP-029)
# ============================================================
CHECK_CAPTURE_MAX_SIZE=5120
CHECK_CAPTURE_DISK=local
CHECK_CAPTURE_BATCH_SIZE=5

# ============================================================
# Check External Forward — FastAPI (CP-030)
# ============================================================
CHECK_EXTERNAL_URL=http://127.0.0.1:9000/api/check/captures
CHECK_EXTERNAL_TIMEOUT=10
CHECK_EXTERNAL_API_KEY=${OCR_CALLBACK_API_KEY}

# ============================================================
# Check OCR Process → FastAPI OCR (CP-034) — callback console log
# ============================================================
CHECK_OCR_URL=http://127.0.0.1:9000/api/check/ocr/process
# Tuning RapidOCR (2026-09-12): batch 5 slot antre di engine lock FastAPI
CHECK_OCR_TIMEOUT=30
CHECK_OCR_API_KEY=${OCR_CALLBACK_API_KEY}
CHECK_OCR_CALLBACK_URL=http://127.0.0.1:8000/api/check/ocr/callback

# ============================================================
# Reference Library permanen — FastAPI (Jalur A push + Jalur B proxy/import)
# ============================================================
FASTAPI_REF_LIBRARY_URL=http://127.0.0.1:9000/api/references
FASTAPI_REF_LIBRARY_TIMEOUT=8
FASTAPI_REF_LIBRARY_API_KEY=${OCR_CALLBACK_API_KEY}
